# EditorConfig helps developers define and maintain consistent
# coding styles between different editors or IDEs
# http://editorconfig.org
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size  = 2
max_line_length=80

[*.rs]
indent_size  = 4
max_line_length=100
