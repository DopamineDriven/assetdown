{
  "name": "@d0paminedriven/docxdown",
  "version": "0.2.0",
  "description": "Convenient Rust-powered docx parsing for Node",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "docx",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "ooxml",
    "word document"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DopamineDriven/assetdown.git"
  },
  "files": [
    "/index.d.ts",
    "/index.js",
    "/browser.js"
  ],
  "type": "module",
  "main": "index.js",
  "browser": "browser.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "yarn build:base",
    "build:base": "napi build --platform --esm --release",
    "build:wasm": "yarn build:wasm32",
    "build:wasm32": "napi build --platform --esm --release --target wasm32-wasip1-threads",
    "format": "run-p format:oxfmt format:rs format:toml",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "format:toml": "taplo format",
    "lint": "oxlint .",
    "lint:rs": "cargo fmt -- --check && cargo clippy --all-features -- -D warnings",
    "version": "napi version",
    "prepare": "husky",
    "test": "yarn tsx --test \"__test__/**/*.spec.ts\"",
    "test:wasi": "NAPI_RS_FORCE_WASI=error yarn tsx --test \"__test__/wasi.spec.ts\""
  },
  "devDependencies": {
    "@d0paminedriven/fs": "catalog:dd",
    "@d0paminedriven/type-utils": "catalog:dd",
    "@emnapi/core": "catalog:emnapi",
    "@emnapi/runtime": "catalog:emnapi",
    "@napi-rs/cli": "catalog:napi",
    "@napi-rs/wasm-runtime": "catalog:napi",
    "@oxc-node/core": "catalog:oxc",
    "@oxc-node/core-wasm32-wasi": "catalog:oxc",
    "@taplo/cli": "catalog:taplo",
    "@tybys/wasm-util": "catalog:tybys",
    "@types/node": "catalog:node",
    "chalk": "catalog:chalk",
    "dotenv": "catalog:dotenv",
    "emnapi": "catalog:emnapi",
    "lint-staged": "catalog:lint",
    "npm-run-all2": "catalog:run-all",
    "oxfmt": "catalog:ox",
    "oxlint": "catalog:ox",
    "tinybench": "catalog:tiny",
    "tslib": "catalog:ts",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts"
  },
  "napi": {
    "binaryName": "docxdown-node",
    "constEnum": false,
    "dtsHeader": "/* auto-generated by @d0paminedriven/docxdown */\n\n",
    "packageName": "@d0paminedriven/docxdown",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
