{
  "name": "@d0paminedriven/mimedown-wasm",
  "version": "0.9.0",
  "description": "Rust-powered MIME sniffing and media facts as WebAssembly, for Node, browsers, and edge runtimes",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "identification",
    "mime",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "sniffing",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DopamineDriven/assetdown.git"
  },
  "files": [
    "mimedown-node-wasm.wasi.cjs",
    "mimedown-node-wasm.wasi.d.cts",
    "mimedown-node-wasm.wasi-browser.js",
    "mimedown-node-wasm.wasm32-wasi.wasm",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs",
    "mimedown-node-wasm.wasip1.cjs",
    "mimedown-node-wasm.wasip1.d.cts",
    "mimedown-node-wasm.wasip1-browser.js",
    "mimedown-node-wasm.wasip1-deferred.js",
    "mimedown-node-wasm.wasip1-deferred.d.ts",
    "mimedown-node-wasm.wasm32-wasip1.wasm",
    "mimedown-node-wasm.wasm32-wasip1.wasm.d.ts",
    "dist/client.js",
    "dist/client.d.ts",
    "dist/protocol.js",
    "dist/protocol.d.ts",
    "dist/worker.js",
    "dist/worker.wasm"
  ],
  "type": "module",
  "main": "mimedown-node-wasm.wasi.cjs",
  "browser": "mimedown-node-wasm.wasip1-browser.js",
  "types": "mimedown-node-wasm.wasi.d.cts",
  "exports": {
    ".": {
      "browser": {
        "types": "./mimedown-node-wasm.wasip1.d.cts",
        "default": "./mimedown-node-wasm.wasip1-browser.js"
      },
      "types": "./mimedown-node-wasm.wasi.d.cts",
      "require": "./mimedown-node-wasm.wasi.cjs",
      "default": "./mimedown-node-wasm.wasi.cjs"
    },
    "./threads": {
      "types": "./mimedown-node-wasm.wasi.d.cts",
      "browser": "./mimedown-node-wasm.wasi-browser.js",
      "require": "./mimedown-node-wasm.wasi.cjs",
      "default": "./mimedown-node-wasm.wasi.cjs"
    },
    "./threadless": {
      "types": "./mimedown-node-wasm.wasip1.d.cts",
      "browser": "./mimedown-node-wasm.wasip1-browser.js",
      "require": "./mimedown-node-wasm.wasip1.cjs",
      "default": "./mimedown-node-wasm.wasip1.cjs"
    },
    "./workerd": {
      "types": "./mimedown-node-wasm.wasip1-deferred.d.ts",
      "default": "./mimedown-node-wasm.wasip1-deferred.js"
    },
    "./wasm": {
      "types": "./mimedown-node-wasm.wasm32-wasip1.wasm.d.ts",
      "default": "./mimedown-node-wasm.wasm32-wasip1.wasm"
    },
    "./wasm.wasm": {
      "types": "./mimedown-node-wasm.wasm32-wasip1.wasm.d.ts",
      "default": "./mimedown-node-wasm.wasm32-wasip1.wasm"
    },
    "./worker": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3",
    "@napi-rs/wasm-runtime": "~1.2.7"
  },
  "napi": {
    "binaryName": "mimedown-node-wasm",
    "constEnum": false,
    "dtsHeader": "/* auto-generated by @d0paminedriven/mimedown-wasm */\n\n",
    "packageName": "@d0paminedriven/mimedown-wasm",
    "targets": [
      "wasm32-wasip1-threads",
      "wasm32-wasip1"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
