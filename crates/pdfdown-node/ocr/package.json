{
  "name": "@d0paminedriven/pdfdown-ocr",
  "version": "0.18.0",
  "description": "Rust powered PDF extraction for Node with OCR and optional rendering (requires system tesseract).",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "extraction",
    "fax",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "scan",
    "tiff"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DopamineDriven/assetdown.git"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "omp.js",
    "pdfdown_ocr.napi.js",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "main": "index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "pdfdown-node-ocr",
    "constEnum": false,
    "dtsHeader": "/* auto-generated by @d0paminedriven/pdfdown-ocr */\n\n",
    "packageName": "@d0paminedriven/pdfdown-ocr",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
