{
  "name": "@d0paminedriven/pdfdown",
  "version": "0.17.0",
  "description": "Rust powered pdf extraction for Node",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "keywords": [
    "pdf",
    "extraction",
    "Rust",
    "node-tooling",
    "rust-based-tooling",
    "invoices"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DopamineDriven/assetdown.git"
  },
  "resolutions": {
    "@napi-rs/wasm-runtime": "1.2.7"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "browser.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "artifacts:ocr": "napi artifacts --package-json-path ocr/package.json --npm-dir ocr/npm",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "yarn build:base",
    "build:base": "napi build --platform --esm --release --features render",
    "build:superset": "napi build --platform --esm --release --features ocr,render --package-json-path ocr/package.json --output-dir ocr --js pdfdown_ocr.napi.js",
    "build:wasm": "yarn build:wasm32",
    "build:wasm32": "napi build --platform --esm --release --features render --target wasm32-wasip1-threads",
    "format": "run-p format:oxfmt format:rs format:toml",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "format:toml": "taplo format",
    "lint": "oxlint .",
    "create-npm-dirs:ocr": "napi create-npm-dirs --package-json-path ocr/package.json --npm-dir ocr/npm",
    "lint:rs": "cargo fmt -- --check && cargo clippy --all-features -- -D warnings",
    "version": "napi version",
    "prepare": "husky",
    "test": "yarn tsx --test \"__test__/**/*.spec.ts\"",
    "test:ocr": "yarn tsx --test \"ocr/__test__/**/*.spec.ts\"",
    "test:wasi": "NAPI_RS_FORCE_WASI=error yarn tsx --test \"__test__/wasi.spec.ts\""
  },
  "devDependencies": {
    "@azure-rest/ai-document-intelligence": "^1.1.0",
    "@d0paminedriven/fs": "^11.0.0",
    "@d0paminedriven/type-utils": "^1.3.0",
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/cli": "^3.10.12",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@oxc-node/core": "^1.0.2",
    "@oxc-node/core-wasm32-wasi": "^1.0.2",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.10",
    "emnapi": "2.0.0-alpha.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mssql": "^12.7.14",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tinybench": "^6.2.3",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "napi": {
    "binaryName": "pdfdown-node",
    "packageName": "@d0paminedriven/pdfdown",
    "constEnum": false,
    "dtsHeader": "/* auto-generated by @d0paminedriven/pdfdown */",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
