{
  "name": "@d0paminedriven/xlsdown-wasm",
  "version": "0.3.0",
  "description": "Rust-powered xls parsing as WebAssembly, for Node, browsers, and edge runtimes",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "excel",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "wasm",
    "webassembly",
    "xls"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DopamineDriven/assetdown.git"
  },
  "files": [
    "xlsdown-node-wasm.wasi.cjs",
    "xlsdown-node-wasm.wasi.d.cts",
    "xlsdown-node-wasm.wasi-browser.js",
    "xlsdown-node-wasm.wasm32-wasi.wasm",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs",
    "xlsdown-node-wasm.wasip1.cjs",
    "xlsdown-node-wasm.wasip1.d.cts",
    "xlsdown-node-wasm.wasip1-browser.js",
    "xlsdown-node-wasm.wasip1-deferred.js",
    "xlsdown-node-wasm.wasip1-deferred.d.ts",
    "xlsdown-node-wasm.wasm32-wasip1.wasm",
    "xlsdown-node-wasm.wasm32-wasip1.wasm.d.ts",
    "dist/client.js",
    "dist/client.d.ts",
    "dist/protocol.js",
    "dist/protocol.d.ts",
    "dist/worker.js",
    "dist/worker.wasm"
  ],
  "type": "module",
  "main": "xlsdown-node-wasm.wasi.cjs",
  "browser": "xlsdown-node-wasm.wasip1-browser.js",
  "types": "xlsdown-node-wasm.wasi.d.cts",
  "exports": {
    ".": {
      "browser": {
        "types": "./xlsdown-node-wasm.wasip1.d.cts",
        "default": "./xlsdown-node-wasm.wasip1-browser.js"
      },
      "types": "./xlsdown-node-wasm.wasi.d.cts",
      "require": "./xlsdown-node-wasm.wasi.cjs",
      "default": "./xlsdown-node-wasm.wasi.cjs"
    },
    "./threads": {
      "types": "./xlsdown-node-wasm.wasi.d.cts",
      "browser": "./xlsdown-node-wasm.wasi-browser.js",
      "require": "./xlsdown-node-wasm.wasi.cjs",
      "default": "./xlsdown-node-wasm.wasi.cjs"
    },
    "./threadless": {
      "types": "./xlsdown-node-wasm.wasip1.d.cts",
      "browser": "./xlsdown-node-wasm.wasip1-browser.js",
      "require": "./xlsdown-node-wasm.wasip1.cjs",
      "default": "./xlsdown-node-wasm.wasip1.cjs"
    },
    "./workerd": {
      "types": "./xlsdown-node-wasm.wasip1-deferred.d.ts",
      "default": "./xlsdown-node-wasm.wasip1-deferred.js"
    },
    "./wasm": {
      "types": "./xlsdown-node-wasm.wasm32-wasip1.wasm.d.ts",
      "default": "./xlsdown-node-wasm.wasm32-wasip1.wasm"
    },
    "./wasm.wasm": {
      "types": "./xlsdown-node-wasm.wasm32-wasip1.wasm.d.ts",
      "default": "./xlsdown-node-wasm.wasm32-wasip1.wasm"
    },
    "./worker": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/wasm-runtime": "~1.2.7"
  },
  "napi": {
    "binaryName": "xlsdown-node-wasm",
    "constEnum": false,
    "dtsHeader": "/* auto-generated by @d0paminedriven/xlsdown-wasm */\n\n",
    "packageName": "@d0paminedriven/xlsdown-wasm",
    "targets": [
      "wasm32-wasip1-threads",
      "wasm32-wasip1"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
