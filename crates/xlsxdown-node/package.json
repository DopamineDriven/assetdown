{
  "name": "@d0paminedriven/xlsxdown",
  "version": "0.7.0",
  "description": "Rust powered xlsx extraction for Node",
  "keywords": [
    "Excel",
    "Rust",
    "Spreadsheet",
    "node-tooling",
    "rust-based-tooling",
    "xlsx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DopamineDriven/assetdown.git"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "type": "module",
  "main": "index.js",
  "browser": "browser.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "yarn build:base",
    "build:base": "napi build --platform --esm --release",
    "build:wasm": "yarn build:wasm32",
    "build:wasm-package": "yarn build:wasm-package:threads && yarn build:wasm-package:threadless && yarn build:wasm-package:worker",
    "build:wasm-package:worker": "cd wasm && ../node_modules/.bin/tsdown",
    "build:wasm-package:threadless": "napi build --platform --no-js --esm --release --target wasm32-wasip1 --package-json-path wasm/package.json --output-dir wasm",
    "build:wasm-package:threads": "napi build --platform --no-js --esm --release --target wasm32-wasip1-threads --package-json-path wasm/package.json --output-dir wasm",
    "build:wasm32": "napi build --platform --esm --release --target wasm32-wasip1-threads",
    "format": "run-p format:oxfmt format:rs format:toml",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "format:toml": "taplo format",
    "lint": "oxlint .",
    "lint:rs": "cargo fmt -- --check && cargo clippy --all-features -- -D warnings",
    "version": "napi version",
    "prepare": "husky",
    "test": "yarn tsx --test \"__test__/**/*.spec.ts\"",
    "test:wasi": "NAPI_RS_FORCE_WASI=error yarn tsx --test \"__test__/wasi.spec.ts\"",
    "test:wasm": "yarn tsx --test \"wasm/__test__/**/*.spec.ts\""
  },
  "devDependencies": {
    "@d0paminedriven/fs": "^12.5.0",
    "@d0paminedriven/type-utils": "^1.3.0",
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/cli": "^3.10.12",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@oxc-node/core": "^1.0.2",
    "@oxc-node/core-wasm32-wasi": "^1.0.2",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.5",
    "@types/node": "^26.6.6",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.10",
    "emnapi": "2.0.0-alpha.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "npm-run-all2": "^9.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "playwright-core": "^1.65.1",
    "rolldown-plugin-wasm": "^0.3.2",
    "tinybench": "^6.2.5",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "@napi-rs/wasm-runtime": "1.2.7"
  },
  "napi": {
    "binaryName": "xlsxdown-node",
    "constEnum": false,
    "dtsHeader": "/* auto-generated by @d0paminedriven/xlsxdown */",
    "packageName": "@d0paminedriven/xlsxdown",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
